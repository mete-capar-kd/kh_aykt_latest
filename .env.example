# Version
APP_VERSION=0.0.0-local
GIT_COMMIT_SHA=local

# Apim
Apim__BaseUrl=<ORGANİZASYONDAN-ALINACAK>
Apim__RouteStyle=<ORGANİZASYONDAN-ALINACAK>
Apim__ApiVersion=<ORGANİZASYONDAN-ALINACAK>
Apim__CacheStatusHeader=
Apim__Auth__Scheme=<ORGANİZASYONDAN-ALINACAK>
Apim__Auth__HeaderName=<ORGANİZASYONDAN-ALINACAK>
Apim__Auth__Key=
Apim__Auth__Scope=<ORGANİZASYONDAN-ALINACAK>
Apim__Deployments__Cheap=<ORGANİZASYONDAN-ALINACAK>
Apim__Deployments__Strong=<ORGANİZASYONDAN-ALINACAK>
Apim__AttemptTimeoutSeconds=60
Apim__MaxAttempts=3

# EntraId
EntraId__Instance=https://login.microsoftonline.com/
EntraId__TenantId=<ORGANİZASYONDAN-ALINACAK>
EntraId__Audience=<ORGANİZASYONDAN-ALINACAK>
EntraId__RequiredRoles__0=
EntraId__RequiredScopes__0=

# Repository
Repository__DefaultUrl=<ORGANİZASYONDAN-ALINACAK>
Repository__DefaultRef=main
Repository__AllowedInputHosts__0=github.com
Repository__AllowedDownloadHosts__0=api.github.com
Repository__AllowedDownloadHosts__1=codeload.github.com
Repository__GitHubToken=

# Assessment
Assessment__MaxFiles=2000
Assessment__MaxTotalBytes=52428800
Assessment__ProfilerTimeoutSeconds=20
Assessment__MetricTimeoutSeconds=140
Assessment__SynthesizerTimeoutSeconds=40
Assessment__GlobalTimeoutSeconds=210
Assessment__MaxConcurrentFullAssessments=2

# Cache
Cache__MetricResultTtlMinutes=120
Cache__MetricResultMaxEntries=1000
Cache__SnapshotMaxBytes=536870912

# RateLimit
RateLimit__PermitsPerMinute=300
RateLimit__QueueLimit=100
RateLimit__ExemptClientIds__0=

# Safety
Safety__CanaryToken=

# Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=
Telemetry__Team=<ORGANİZASYONDAN-ALINACAK>
Telemetry__Application=hackathon-assessment-api
Telemetry__Environment=local
Telemetry__SamplingRatio=1.0
